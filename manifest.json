{
  "manifest_version": 3,
  "name": "A.D.A.P.T.",
  "version": "1.0.0",
  "description": "Transform your web pages to be more accessible",
  "permissions": ["activeTab", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["images/*", "fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "theme.js",
        "toolbar-template.js",
        "content.js",
        "toolbar.js",
        "processing/font.js",
        "processing/size.js",
        "processing/leading.js",
        "processing/spacing.js",
        "processing/bold.js",
        "processing/italics.js",
        "processing/underline.js",
        "tools/lineguide.js",
        "tools/highlighter.js"
      ]
    }
  ],
  "icons": {
    "48": "images/icon-48.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png"
  }
}