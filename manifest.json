{
  "manifest_version": 3,
  "name": "A.D.A.P.T.",
  "version": "1.1.0",
  "description": "Transform your web pages to be more accessible",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "fonts/*.woff2",
        "stickerPallet.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "theme.js",
        "sticker-pallet.js",
        "toolbar-template.js",
        "content.js",
        "state.js",
        "background.js",
        "processing/font.js",
        "processing/size.js",
        "processing/leading.js",
        "processing/spacing.js",
        "processing/bold.js",
        "processing/italics.js",
        "processing/underline.js",
        "tools/lineguide.js",
        "tools/highlighter.js",
        "tools/note.js",
        "tools/sticker.js",
        "tools/define.js",
        "tools/speak.js",
        "settings.js",
        "toolbar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "images/icon-48.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png"
  }
}
